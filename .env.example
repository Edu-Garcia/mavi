# Copie este arquivo para `.env` e preencha as chaves.
# Nunca commite o arquivo `.env` nem cole segredos reais neste exemplo.

GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Docker / runtime local (valores padrão já funcionam no compose)
PORT=3000
DATABASE_PATH=./data/mavi.db
SCREENSHOT_DIR=./data/screenshots
AXE_HTML_DIR=./data/axe-html
VITE_API_URL=http://localhost:3000
